# Copy to .env (git-ignored). `bun run …` and Next load it automatically.
DATABASE_URL=postgresql://homedetailing:homedetailing_dev@127.0.0.1:5432/homedetailing
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_REGISTRATION_CODE=replace-with-a-one-time-registration-code
# Integration tests use the homedetailing_test database from compose.yml.
# Override only when it lives elsewhere:
# TEST_DATABASE_URL=postgresql://homedetailing:homedetailing_dev@127.0.0.1:5432/homedetailing_test

# Values for compose.prod.yml. Copy to .env.production (git-ignored) and fill in.
POSTGRES_DB=homedetailing
POSTGRES_USER=homedetailing
POSTGRES_PASSWORD=replace-with-a-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_REGISTRATION_CODE=replace-with-a-one-time-registration-code
# Host port and bind address for the app (reverse proxy usually sits in front).
APP_PORT=3000
APP_BIND=127.0.0.1
# Point at a registry tag instead of building locally.
# APP_IMAGE=homedetailing/app:local
